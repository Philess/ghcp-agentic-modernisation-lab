{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Order Service: Start Frontend",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/app/Java - Spring Boot/Order Service/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^\\s*(?:error|Error):\\s*(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*ready in.*",
          "endsPattern": ".*Local:.*http://127\\.0\\.0\\.1:5173/.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "order-service"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}